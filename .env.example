# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# The deployed service never reads `.env` — Cloud Run gets these values as
# environment variables (see deploy.ps1 / deploy.sh). This file is for running
# the server locally.
#
# To export them without a .env file:
#   PowerShell:  $env:MCP_AUTH_TOKEN = "mcp_your_key"
#   bash:        export MCP_AUTH_TOKEN=mcp_your_key

# The shared key every request must carry as `Authorization: Bearer <key>`.
# Leave it empty (or unset) to turn the check off for a local run.
MCP_AUTH_TOKEN=

# Cloud Run injects PORT itself; set it only to run on a different local port.
# PORT=8080
