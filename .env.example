# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# The deployed service never reads `.env` — Cloud Run gets these values as
# environment variables (set-token.ps1 / set-token.sh write MCP_AUTH_TOKEN there).
# This file is only for running the server locally.
#
# To export them without a .env file:
#   PowerShell:  $env:MCP_AUTH_TOKEN = "mcp_local_test_token"
#   bash:        export MCP_AUTH_TOKEN=mcp_local_test_token

# The MCP token every request must carry as an `Authorization: Bearer` header.
#
# On Cloud Run this is the token the apex auth server issued for the deployed URL,
# written after the service was deployed and registered — see README.md. The deploy
# scripts populate it with the placeholder "replace-with-issued-token" first, so the
# variable is never simply missing.
#
# The check is always on: empty or the placeholder means "not authorized yet", so
# every request gets 503. Locally, any value other than the placeholder works; it
# only has to match what curl sends.
MCP_AUTH_TOKEN=

# Cloud Run injects PORT itself; set it only to run on a different local port.
# PORT=8080